# ==============================================================================
# n8n EC2 Deploy - Environment Variables Reference
# ==============================================================================

# Application & Domain Settings
N8N_HOST=automation.example.com
N8N_PORT=5678
N8N_PROTOCOL=https
WEBHOOK_URL=https://automation.example.com/
N8N_EDITOR_BASE_URL=https://automation.example.com/
N8N_PROXY_HOPS=1

# n8n Core Security (64-character hex key)
N8N_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# General Runtime Settings
GENERIC_TIMEZONE=UTC
EXECUTIONS_DATA_PRUNE=true
EXECUTIONS_DATA_MAX_AGE=336

# Database Configuration (PostgreSQL)
DB_TYPE=postgresdb
DB_POSTGRESDB_HOST=postgres
DB_POSTGRESDB_PORT=5432
DB_POSTGRESDB_DATABASE=n8n
DB_POSTGRESDB_USER=n8n
DB_POSTGRESDB_PASSWORD=replace_with_strong_generated_password
DB_POSTGRESDB_SCHEMA=public
DB_POSTGRESDB_SSL_REJECT_UNAUTHORIZED=true

# Reverse Proxy Configuration (optional)
PROXY_PROVIDER=none # none | nginx | traefik
DOMAIN_NAME=automation.example.com
SSL_EMAIL=admin@example.com

